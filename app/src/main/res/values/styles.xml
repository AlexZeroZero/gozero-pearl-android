<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#B898FF</item>
        <item name="android:windowBackground">#0D0B12</item>
        <item name="android:statusBarColor">#0D0B12</item>
        <item name="android:navigationBarColor">#0D0B12</item>
    </style>
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#6840AB</item>
        <item name="android:windowBackground">#F5F3FA</item>
        <item name="android:statusBarColor">#F5F3FA</item>
        <item name="android:navigationBarColor">#F5F3FA</item>
    </style>
</resources>
